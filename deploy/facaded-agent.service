[Unit]
Description=facade agent
After=network-online.target docker.service
# Docker is wanted, not required: Docker failing once at boot (it then
# restarts by itself) would otherwise leave facade down for good. Without
# Docker the agent keeps retrying, and restarting Docker leaves facade running.
Wants=network-online.target facaded-ingress.service docker.service

[Service]
# The node's entry point runs on its own (facaded-ingress.service), so updating
# the agent never drops traffic.
ExecStart=/usr/local/bin/facaded agent --data-dir /var/lib/facade-agent --ingress-control /run/facade/ingress.sock
Restart=always
RestartSec=3
Environment=RUST_LOG=info
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
